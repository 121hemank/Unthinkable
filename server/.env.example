# Server environment — copy to .env and fill in.
# NEVER commit the real .env.

# Port (Render/Railway inject their own PORT; local dev defaults to 5000)
PORT=5000

# Comma-separated list of allowed browser origins (no trailing slash)
CLIENT_URL=http://localhost:5173

# MongoDB connection string. Local dev uses a replica set (required for
# transactions): mongod --replSet rs0 --dbpath <path>
# Production: Atlas M0 free tier connection string.
MONGO_URI=mongodb://localhost:27017/healthcare?replicaSet=rs0

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# SMTP for emails (Gmail: enable 2FA, create an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your@gmail.com
SMTP_PASS=your-16-char-app-password
EMAIL_FROM="Clinic Desk <your@gmail.com>"

# Gemini (https://aistudio.google.com/apikey) — free tier is enough
GEMINI_API_KEY=your-gemini-key
GEMINI_MODEL=gemini-2.5-flash

# Google Calendar OAuth (https://console.cloud.google.com → OAuth client)
# Authorized redirect URIs must include BOTH:
#   http://localhost:5000/api/auth/google/callback        (local dev)
#   https://<your-render-app>.onrender.com/api/auth/google/callback (prod)
GOOGLE_CLIENT_ID=xxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxx
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# Shared secret protecting admin-only cron trigger endpoint (optional)
CRON_SECRET=change-me-too

# Client environment (client/.env.local) — where the SPA finds the API:
# VITE_API_URL=http://localhost:5000/api
